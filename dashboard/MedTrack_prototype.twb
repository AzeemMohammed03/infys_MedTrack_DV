      <aliases enabled='yes' />
      <column caption='Admission Date' datatype='date' name='[Admission_Date]' role='dimension' type='ordinal' />
      <column caption='Admission Month' datatype='integer' name='[Admission_Month]' role='dimension' type='quantitative' />
      <column caption='Admission Month Name' datatype='string' name='[Admission_Month_Name]' role='dimension' type='nominal' />
      <column caption='Admission Year' datatype='integer' name='[Admission_Year]' role='dimension' type='quantitative' />
      <column caption='Admission Year Month' datatype='string' name='[Admission_Year_Month]' role='dimension' type='nominal' />
      <column caption='Available Medical Equipment' datatype='integer' name='[Available_Medical_Equipment]' role='measure' type='quantitative' />
      <column caption='Bed Utilization Rate' datatype='real' name='[Bed_Utilization_Rate]' role='measure' type='quantitative' />
      <column caption='Discharges' datatype='integer' name='[Calculation_0193274734948352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([Discharge_Date])&#13;&#10;    THEN [Patient_ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='occupancy Rate' datatype='real' name='[Calculation_0966228802084864]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Occupied_Beds]) / SUM([Total_Beds]) * 100' />
      </column>
      <column caption='readmission rate' datatype='real' name='[Calculation_0966228803276801]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Readmission_Status] = &quot;Yes&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Patient_ID])&#13;&#10;* 100' />
      </column>
      <column caption='Mortality Rate' datatype='real' name='[Calculation_0966228803653634]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Outcome] = &quot;Deceased&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Patient_ID])&#13;&#10;* 100' />
      </column>
      <column caption='occupancy trend' datatype='real' name='[Calculation_0966228806172675]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Occupied_Beds]) / SUM([Total_Beds]) * 100' />
      </column>
      <column caption='Discharge Month' datatype='datetime' name='[Calculation_1381571827998720]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Discharge_Date])' />
      </column>
      <column caption='Department Efficiency Score' datatype='real' name='[Department_Efficiency_Score]' role='measure' type='quantitative' />
